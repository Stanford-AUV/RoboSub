<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- See https://github.com/gazebosim/harmonic_demo/blob/8954ffb15e0ac7ffafe164889f273d94e7f6cb40/harmonic_demo/Tethys%20Sensors/model.sdf for examples of an AUV model with sensors -->
    <model name="auv">

        <link name='base_link'>
            <pose>0 0 0 0 0 0</pose>
            <inertial>
                <mass>19.27</mass>
                <inertia>
                    <ixx>0.4718</ixx>
                    <ixy>0.0000</ixy>
                    <ixz>0.0000</ixz>
                    <iyy>0.6063</iyy>
                    <iyz>0.0000</iyz>
                    <izz>0.7638</izz>
                </inertia>
            </inertial>
            <visual name='base_visual'>
                <geometry>
                    <box>
                        <size>0.44 0.22 0.25</size>
                    </box>
                </geometry>
            </visual>
            <collision name='base_collision'>
                <geometry>
                    <box>
                        <size>0.44 0.22 0.25</size>
                    </box>
                </geometry>
            </collision>
            <sensor name="imu_sensor" type="imu">
                <always_on>1</always_on>
                <update_rate>400</update_rate>
                <visualize>true</visualize>
                <topic>imu</topic>
            </sensor>
            <sensor name="altimeter" type="altimeter">
                <always_on>1</always_on>
                <update_rate>50</update_rate>
                <topic>altimeter</topic>
            </sensor>
            <sensor name="oak_0_rgb" type="camera">
                <pose>0 0 -0.13 0 1.5708 0</pose>
                <always_on>1</always_on>
                <update_rate>20</update_rate>
                <topic>oak_0/rgb</topic>
                <camera>
                    <horizontal_fov>1.05</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>30</far>
                    </clip>
                </camera>
            </sensor>
            <sensor name="oak_0_depth" type="depth_camera">
                <pose>0 0 -0.13 0 1.5708 0</pose>
                <always_on>1</always_on>
                <update_rate>20</update_rate>
                <topic>oak_0/depth</topic>
                <camera>
                    <horizontal_fov>1.05</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>400</height>
                        <format>R_FLOAT32</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>30</far>
                    </clip>
                </camera>
            </sensor>
            
            <!-- DVL (Wayfinder). x from hardware/sensors.yaml dvl_0.sensor_pos_in_base; z moved just below the sim hull. -->
            <sensor name="dvl" type="custom" gz:type="dvl">
                <pose>-0.125 0 -0.13 0 0 0</pose>
                <always_on>1</always_on>
                <update_rate>5</update_rate>
                <topic>dvl</topic>
                <gz:dvl>
                    <type>phased_array</type>
                    <arrangement degrees="true">
                        <beam id="1"><aperture>2.1</aperture><rotation>45</rotation><tilt>30</tilt></beam>
                        <beam><aperture>2.1</aperture><rotation>135</rotation><tilt>30</tilt></beam>
                        <beam><aperture>2.1</aperture><rotation>-45</rotation><tilt>30</tilt></beam>
                        <beam><aperture>2.1</aperture><rotation>-135</rotation><tilt>30</tilt></beam>
                    </arrangement>
                    <tracking>
                        <bottom_mode>
                            <when>best</when>
                            <visualize>false</visualize>
                        </bottom_mode>
                    </tracking>
                    <resolution>0.01</resolution>
                    <maximum_range>80</maximum_range>
                    <minimum_range>0.1</minimum_range>
                </gz:dvl>
            </sensor>

        </link>

        <!-- Thruster Links -->
        <link name='box_0'>
            <pose>0.2025 0.1825 0.0925 3.1415926536 -1.5707963268 -0.7853981634</pose>            <!-- Position adjustment needed -->
            <visual name="visual_side_1">
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>                    <!-- Red color -->
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <visual name="visual_side_2">
                <pose>0 0 -0.01 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>                    <!-- Blue color -->
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <box>
                        <size>0.2 0.01 0.2</size>
                    </box>
                </geometry>
            </collision>
        </link>

        <link name='box_1'>
            <pose>0.2025 -0.1825 0.0925 3.1415926536 -1.5707963268 0.7853981634</pose>            <!-- Position adjustment needed -->
            <visual name="visual_side_1">
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>                    <!-- Red color -->
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <visual name="visual_side_2">
                <pose>0 0 -0.01 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>                    <!-- Blue color -->
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <box>
                        <size>0.2 0.01 0.2</size>
                    </box>
                </geometry>
            </collision>
        </link>

        <link name='box_2'>
            <pose>-0.2025 0.1825 0.0925 0 -1.5707963268 0.7853981634</pose>            <!-- Position adjustment needed -->
            <visual name="visual_side_1">
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>                    <!-- Red color -->
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <visual name="visual_side_2">
                <pose>0 0 -0.01 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>                    <!-- Blue color -->
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <box>
                        <size>0.2 0.01 0.2</size>
                    </box>
                </geometry>
            </collision>
        </link>

        <link name='box_3'>
            <pose>-0.2025 -0.1825 0.0925 0 -1.5707963268 -0.7853981634</pose>            <!-- Position adjustment needed -->
            <visual name="visual_side_1">
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>                    <!-- Red color -->
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <visual name="visual_side_2">
                <pose>0 0 -0.01 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>                    <!-- Blue color -->
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <box>
                        <size>0.2 0.01 0.2</size>
                    </box>
                </geometry>
            </collision>
        </link>

        <link name='box_4'>
            <pose>0.115 0.165 -0.0925 3.1415926536 0 0</pose>            <!-- Position adjustment needed -->
            <visual name="visual_side_1">
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>                    <!-- Red color -->
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <visual name="visual_side_2">
                <pose>0 0 -0.01 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>                    <!-- Blue color -->
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <box>
                        <size>0.2 0.01 0.2</size>
                    </box>
                </geometry>
            </collision>
        </link>

        <link name='box_5'>
            <pose>0.115 -0.165 -0.0925 3.1415926536 0 0</pose>            <!-- Position adjustment needed -->
            <visual name="visual_side_1">
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>                    <!-- Red color -->
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <visual name="visual_side_2">
                <pose>0 0 -0.01 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>                    <!-- Blue color -->
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <box>
                        <size>0.2 0.01 0.2</size>
                    </box>
                </geometry>
            </collision>
        </link>

        <link name="box_6">
            <pose>-0.115 +0.165 -0.0925 0 0 0</pose>
            <visual name="visual_side_1">
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>                    <!-- Red color -->
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <visual name="visual_side_2">
                <pose>0 0 -0.01 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>                    <!-- Blue color -->
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <box>
                        <size>0.2 0.01 0.2</size>
                    </box>
                </geometry>
            </collision>
        </link>

        <link name='box_7'>
            <pose>-0.115 -0.165 -0.0925 3.1415926536 0 0</pose>            <!-- Position adjustment needed -->
            <visual name="visual_side_1">
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>                    <!-- Red color -->
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <visual name="visual_side_2">
                <pose>0 0 -0.01 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.2 0.2 0.01</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>                    <!-- Blue color -->
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <collision name="collision">
                <geometry>
                    <box>
                        <size>0.2 0.01 0.2</size>
                    </box>
                </geometry>
            </collision>
        </link>

        <!-- Thruster Joints -->
        <joint name='thruster_0' type='revolute'>
            <pose>0 0 0 0 0 0</pose>
            <parent>base_link</parent>
            <child>box_0</child>
            <axis>
                <xyz>-1 1 0</xyz>
                <use_parent_model_frame>1</use_parent_model_frame>
                <limit>
                    <lower>-1e+12</lower>
                    <upper>1e+12</upper>
                    <effort>-1</effort>
                    <velocity>-1</velocity>
                </limit>
            </axis>
        </joint>

        <joint name='thruster_1' type='revolute'>
            <pose>0 0 0 0 0 0</pose>
            <parent>base_link</parent>
            <child>box_1</child>
            <axis>
                <xyz>-1 -1 0</xyz>
                <use_parent_model_frame>1</use_parent_model_frame>
                <limit>
                    <lower>-1e+12</lower>
                    <upper>1e+12</upper>
                    <effort>-1</effort>
                    <velocity>-1</velocity>
                </limit>
            </axis>
        </joint>

        <joint name='thruster_2' type='revolute'>
            <pose>0 0 0 0 0 0</pose>
            <parent>base_link</parent>
            <child>box_2</child>
            <axis>
                <xyz>1 1 0</xyz>
                <use_parent_model_frame>1</use_parent_model_frame>
                <limit>
                    <lower>-1e+12</lower>
                    <upper>1e+12</upper>
                    <effort>-1</effort>
                    <velocity>-1</velocity>
                </limit>
            </axis>
        </joint>

        <joint name='thruster_3' type='revolute'>
            <pose>0 0 0 0 0 0</pose>
            <parent>base_link</parent>
            <child>box_3</child>
            <axis>
                <xyz>1 -1 0</xyz>
                <use_parent_model_frame>1</use_parent_model_frame>
                <limit>
                    <lower>-1e+12</lower>
                    <upper>1e+12</upper>
                    <effort>-1</effort>
                    <velocity>-1</velocity>
                </limit>
            </axis>
        </joint>

        <joint name='thruster_4' type='revolute'>
            <pose>0 0 0 0 0 0</pose>
            <parent>base_link</parent>
            <child>box_4</child>
            <axis>
                <xyz>0 0 1</xyz>
                <use_parent_model_frame>1</use_parent_model_frame>
                <limit>
                    <lower>-1e+12</lower>
                    <upper>1e+12</upper>
                    <effort>-1</effort>
                    <velocity>-1</velocity>
                </limit>
            </axis>
        </joint>

        <joint name='thruster_5' type='revolute'>
            <pose>0 0 0 0 0 0</pose>
            <parent>base_link</parent>
            <child>box_5</child>
            <axis>
                <xyz>0 0 1</xyz>
                <use_parent_model_frame>1</use_parent_model_frame>
                <limit>
                    <lower>-1e+12</lower>
                    <upper>1e+12</upper>
                    <effort>-1</effort>
                    <velocity>-1</velocity>
                </limit>
            </axis>
        </joint>

        <joint name='thruster_6' type='revolute'>
            <pose>0 0 0 0 0 0</pose>
            <parent>base_link</parent>
            <child>box_6</child>
            <axis>
                <xyz>0 0 -1</xyz>
                <use_parent_model_frame>1</use_parent_model_frame>
                <limit>
                    <lower>-1e+12</lower>
                    <upper>1e+12</upper>
                    <effort>-1</effort>
                    <velocity>-1</velocity>
                </limit>
            </axis>
        </joint>

        <joint name='thruster_7' type='revolute'>
            <pose>0 0 0 0 0 0</pose>
            <parent>base_link</parent>
            <child>box_7</child>
            <axis>
                <xyz>0 0 1</xyz>
                <use_parent_model_frame>1</use_parent_model_frame>
                <limit>
                    <lower>-1e+12</lower>
                    <upper>1e+12</upper>
                    <effort>-1</effort>
                    <velocity>-1</velocity>
                </limit>
            </axis>
        </joint>

        <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
            <publish_model_pose>true</publish_model_pose>
            <publish_link_pose>false</publish_link_pose>
            <publish_visual_pose>false</publish_visual_pose>
            <publish_collision_pose>false</publish_collision_pose>
            <publish_sensor_pose>false</publish_sensor_pose>
            <publish_nested_model_pose>true</publish_nested_model_pose>
            <update_frequency>1000</update_frequency>
        </plugin>
    </model>
</sdf>